# ===== 本地 Docker 验证配置 =====
ENVIRONMENT=development

# 本地独立数据库容器（映射到宿主机 5433，避免占用已有 5432）
POSTGRES_DB=iqc_insp
POSTGRES_USER=iqc
POSTGRES_PASSWORD=iqc_local_password
DB_PORT=5435
DATABASE_URL=postgresql+psycopg://iqc:iqc_local_password@db:5432/iqc_insp

# 生产环境务必替换：openssl rand -hex 32
SECRET_KEY=local-dev-secret-key-please-replace-with-64-hex-chars
ACCESS_TOKEN_EXPIRE_MINUTES=480

# 首次启动自动创建管理员；已存在时不会覆盖密码
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@123456
ADMIN_DISPLAY_NAME=光伏质量部管理员

MAX_UPLOAD_MB=25
UPLOAD_DIR=uploads
CORS_ORIGINS=http://localhost:8088,http://127.0.0.1:8088,http://localhost:5173,http://127.0.0.1:5173

WEB_PORT=8088

# 保留旧卷名，避免重命名项目时丢失已上传文件
UPLOAD_VOLUME=iqc-insp_iqc_uploads
API_IMAGE=quality-iqc-api:1.1.0
WEB_IMAGE=quality-iqc-web:1.1.0
