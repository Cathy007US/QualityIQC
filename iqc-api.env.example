# ============================================================
# quality-Iqc 生产配置模板
# 用法：cp iqc-api.env.example iqc-api.env，填好后执行：
#   ./scripts/deploy.sh config    （已有服务器）
#   ./scripts/deploy.sh init      （首次部署）
#
# 本文件含密码，不要提交到 git。deploy.sh 会据此自动生成 DATABASE_URL。
# ============================================================

ENVIRONMENT=production

# ---------- 自带 PostgreSQL（新架构）----------
# 首次启动会按这组值创建库和用户；之后改密码请用 deploy.sh config（会自动 ALTER USER）
POSTGRES_DB=iqc_insp
POSTGRES_USER=iqc_user
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD

# DATABASE_URL 由 deploy.sh 根据上面的 POSTGRES_* 自动生成并写回本文件，
# 主机固定为 db（compose 内的服务名），密码自动 URL 编码。不要手改这一行。
DATABASE_URL=postgresql+psycopg://iqc_user:CHANGE_ME_DB_PASSWORD@db:5432/iqc_insp

# ---------- 应用安全 ----------
# openssl rand -hex 32 的输出；变更会使旧 token 失效
SECRET_KEY=CHANGE_ME_TO_A_RANDOM_64_HEX_SECRET
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ---------- 管理员账号 ----------
# 仅首次启动、库里无该用户时创建
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD
ADMIN_DISPLAY_NAME=光伏质量部管理员

# ---------- 业务参数 ----------
MAX_UPLOAD_MB=25
UPLOAD_DIR=uploads
# 换成真实域名
CORS_ORIGINS=https://aa.xxx.com

# Web 容器映射到宿主机回环的端口（由宿主机 Nginx 反代）
WEB_PORT=8088

# 数据卷名字（默认沿用旧上传卷名，历史文件自动保留；一般不用改）
UPLOAD_VOLUME=quality-iqc_iqc_uploads
PG_VOLUME=quality-iqc_pgdata
