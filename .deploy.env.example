# 复制本文件为 .deploy.env，填服务器信息（.deploy.env 不要提交/外传）
# 用法：cp .deploy.env.example .deploy.env && vi .deploy.env

# SSH 登录目标（用户名@IP，或 ~/.ssh/config 里的别名）
SERVER=ubuntu@82.157.190.184

# 服务器上的项目目录（与当前生产目录一致，沿用原路径）
REMOTE_DIR=/home/ubuntu/quality-iqc

# 可选：私钥路径，默认用 ~/.ssh/id_rsa 或 ssh-agent
# SSH_KEY=/Users/you/.ssh/id_ed25519

# 生产编排文件名（一般不用改）
COMPOSE_FILE=docker-compose.prod.yml

# 服务器上的配置文件名（一般不用改）
ENV_FILE=iqc-api.env
