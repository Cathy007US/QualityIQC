# ===== 生产环境配置（复制为 .env，放在服务器 /home/ubuntu/quality-iqc）=====
ENVIRONMENT=production

# 复用现有 PostgreSQL 16 的 5432 端口，使用独立 iqc_insp 库
# 密码请使用 URL 编码；若数据库仅监听 127.0.0.1，请把 host.docker.internal 改为可访问的宿主机地址
DATABASE_URL=postgresql+psycopg://iqc_user:CHANGE_ME@host.docker.internal:5432/iqc_insp

# 必须替换：openssl rand -hex 32
SECRET_KEY=CHANGE_ME_TO_A_RANDOM_64_HEX_SECRET
ACCESS_TOKEN_EXPIRE_MINUTES=480

ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD
ADMIN_DISPLAY_NAME=光伏质量部管理员

MAX_UPLOAD_MB=25
UPLOAD_DIR=uploads
# 替换为真实域名；不要提交真实值
CORS_ORIGINS=https://aa.xxx.com

WEB_PORT=8088

# 预构建镜像标签，必须与 docker load 的镜像标签一致
API_IMAGE=quality-iqc-api:1.1.0
WEB_IMAGE=quality-iqc-web:1.1.0

# 全新服务器使用 quality-iqc_iqc_uploads；从旧项目升级时改成原上传卷名
UPLOAD_VOLUME=quality-iqc_iqc_uploads
